{
  "reqforge.jira.projectKey": "",

  // Always-on repo context. AGENTS.md at the root is the single source of
  // truth; there is deliberately no .github/copilot-instructions.md, because
  // both are always-on and keeping two copies in sync is how they drift.
  "chat.useAgentsMdFile": true,

  // control-plane/web/AGENTS.md is generated by `next dev` and carries real
  // Next.js version warnings. Nested discovery is what keeps it applying.
  "chat.useNestedAgentsMdFiles": true,

  // Path-scoped rules in .github/instructions/*.instructions.md, matched by
  // their applyTo globs.
  "chat.includeApplyingInstructions": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  }
}
