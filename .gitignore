# macOS finder metadata, and scratch directories from the doc generators.
# Excluded rather than committed: neither is anyone's intent, and .DS_Store
# reappears on every folder anyone opens.
.DS_Store
.tmp-doc-update/
.tmp-pdlc-deck/

# The exported code graph is a live artefact: the control plane overwrites it
# on every sync. Tracking it meant whichever repository was last indexed got
# committed as though it were this one's — a clone arrived holding a graph of
# somebody else's application, and scoped against modules it does not have.
# Regenerate with the export rather than reading it out of git.
execution-plane/qa/code-graph.json
