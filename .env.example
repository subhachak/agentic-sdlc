# Copy to .env and adjust. Every var used by apps/api/app/core/config.py is documented here.

# --- Database (SQLite, file-based) ---
DATABASE_URL=sqlite+aiosqlite:///./agentic_sdlc.db
# LangGraph checkpoint DB is a separate file, derived automatically from DATABASE_URL.

# --- Adapter selection (config-driven, ports-and-adapters) ---
# Only "mock" and "claude" are implemented in this phase.
LLM_PROVIDER_ADAPTER=mock
CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Remote execution (WorkDispatch) ---
# "local" simulates a CI job with no GitHub, no token and no network — the
# default so the pipeline is demonstrable on a laptop.
WORK_DISPATCH_ADAPTER=local
LOCAL_DISPATCH_DURATION_SECONDS=3
# Needed only when WORK_DISPATCH_ADAPTER=github-actions. The token needs
# actions:write to dispatch and actions:read to fetch the result artifact.
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_WORKFLOW_FILE=agentic-qa.yml
GITHUB_REF=main
# How long a dispatched phase may run before the run is failed as timed out.
DISPATCH_TIMEOUT_SECONDS=1800
RECONCILER_INTERVAL_SECONDS=5

# --- Code intelligence (context graph seeding) ---
# "github" fetches a repository archive and parses it; "local" indexes a
# directory. Neither ever executes what it reads.
CODE_INTELLIGENCE_ADAPTER=github
# Default repository for `POST /api/graph/seed` when the request omits one.
CODE_INDEX_REPO=
CODE_INDEX_REF=main
# A component is a directory collapsed to this many path segments. Deeper
# means finer components; too shallow and a whole service becomes one node.
CODE_INDEX_MAX_DEPTH=4
CODE_INDEX_LOCAL_ROOT=.

# --- Reliability ---
MAX_NODE_RETRIES=2

# --- Gate behavior ---
# When true, gates auto-approve instead of pausing — used for headless/eval runs, never for a live demo.
AUTO_APPROVE_GATES=false

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
